class Solution {
    public int[] nextGreaterElement(int[] nums1, int[] nums2) {
        
        
        for(int i=0;i<nums1.length;i++)
        {
            int max = -1;
            boolean found = false;
            for(int j=0;j<nums2.length;j++)
            {
                if(nums1[i]==nums2[j])
                {
                    found = true;
                }
                if(found  && nums2[j]>nums1[i])
                {
                    max = nums2[j];
                    break;
                }
            }
            nums1[i] = max;
        }
        return nums1;
    }
}


