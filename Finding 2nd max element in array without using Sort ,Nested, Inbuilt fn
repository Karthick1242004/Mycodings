import java.util.*;
class Main
{
    public static void main(String args[])
    {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int a[] = new int[n];
        for(int i=0;i<n;i++)
        {
            a[i] = sc.nextInt();
        }
        int max = 0;
        int min = 0;
        for(int i=0;i<n;i++)
        {
            if(a[i]>max)
            {
                min = max;
                max = a[i];
            }
        }
        System.out.print(min);
    }
}
